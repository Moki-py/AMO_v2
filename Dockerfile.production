# Multi-stage Dockerfile для AmoCRM Data Exporter
# Оптимизирован для production использования

# Stage 1: Build stage
FROM python:3.11-slim as builder

ARG BUILD_ENV=production
ENV BUILD_ENV=${BUILD_ENV}

# Установка системных зависимостей для сборки
RUN apt-get update && apt-get install -y \
    build-essential \
    gcc \
    g++ \
    git \
    && rm -rf /var/lib/apt/lists/*

# Создание пользователя для безопасности
RUN groupadd -r appuser && useradd -r -g appuser appuser

# Установка Python зависимостей
WORKDIR /app
COPY requirements.txt .

# Создание виртуального окружения
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Обновление pip и установка зависимостей
RUN pip install --no-cache-dir --upgrade pip setuptools wheel
RUN pip install --no-cache-dir -r requirements.txt
RUN pip install --no-cache-dir 'faststream[cli]' uvicorn[standard] gunicorn

# Stage 2: Runtime stage
FROM python:3.11-slim as runtime

ARG BUILD_ENV=production
ENV BUILD_ENV=${BUILD_ENV}
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# Установка только runtime зависимостей
RUN apt-get update && apt-get install -y \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Создание пользователя
RUN groupadd -r appuser && useradd -r -g appuser appuser

# Копирование виртуального окружения из builder stage
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Создание директорий
WORKDIR /app
RUN mkdir -p /app/logs /app/data && \
    chown -R appuser:appuser /app

# Копирование кода приложения
COPY --chown=appuser:appuser . .

# Установка прав доступа
RUN chmod +x /app/*.py || true
RUN chmod +x /app/*.sh || true

# Переключение на non-root пользователя
USER appuser

# Health check
HEALTHCHECK --interval=30s --timeout=30s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Порты
EXPOSE 8000

# Команда по умолчанию
CMD ["uvicorn", "modern_ui_server:app", "--host", "0.0.0.0", "--port", "8000"]