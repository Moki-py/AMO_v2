# =============================================================================
# НАСТРОЙКИ ОКРУЖЕНИЯ ДЛЯ PRODUCTION РАЗВЕРТЫВАНИЯ
# =============================================================================

# -----------------------------------------------------------------------------
# RabbitMQ настройки
# -----------------------------------------------------------------------------
RABBITMQ_USER=admin
RABBITMQ_PASS=4RFV5tgb6YHN
RABBITMQ_HOST=5.129.201.34

# -----------------------------------------------------------------------------
# MongoDB настройки
# -----------------------------------------------------------------------------
MONGODB_ROOT_USER=admin
MONGODB_ROOT_PASS=4RFV5tgb6YHN
MONGODB_DB=amocrm_exporter

# URI для подключения к MongoDB с аутентификацией
MONGODB_URI=mongodb://admin:4RFV5tgb6YHN@5.129.201.34:27017/amocrm_exporter?authSource=admin

# -----------------------------------------------------------------------------
# Настройки воркеров и API
# -----------------------------------------------------------------------------
# Количество воркеров для обработки задач
WORKER_COUNT=4

# Количество воркеров для API сервера
API_WORKERS=2

# -----------------------------------------------------------------------------
# Логирование
# -----------------------------------------------------------------------------
# Уровень логирования (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# CORS настройки
# -----------------------------------------------------------------------------
# Разрешенные домены для CORS (* для всех доменов)
CORS_ORIGINS=*

# -----------------------------------------------------------------------------
# Дополнительные настройки (опционально)
# -----------------------------------------------------------------------------
# Настройки для production среды
ENV=production

# MongoDB пул соединений
# MONGODB_POOL_SIZE=50
# MONGODB_MAX_IDLE_TIME=60000

# Redis настройки
REDIS_TTL_SECONDS=3600

# Настройки повторных попыток
MAX_RETRIES=3
RETRY_DELAY=15

# Размер буфера для батчевой обработки
BATCH_BUFFER_SIZE=10